# ── Supabase ──────────────────────────────────────────────────────────────────
# From: supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# From: console.upstash.com → your database → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── YouTube ───────────────────────────────────────────────────────────────────
# Shared key used for all users. Get from Google Cloud Console -> Credentials.
YOUTUBE_API_KEY=AIzaSy...

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Shared CDN used for Instagram media uploads. Get from cloudinary.com -> Dashboard.
# Create an unsigned upload preset: Settings -> Upload -> Upload Presets -> Add preset.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ── Instagram OAuth ───────────────────────────────────────────────────────────
# From: developers.facebook.com -> your app -> Instagram -> API setup with Instagram login
# Register this redirect URI in your app dashboard:
#   http://localhost:8787/api/auth/instagram/callback  (local dev)
#   https://your-worker.workers.dev/api/auth/instagram/callback  (production)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# ── URLs ──────────────────────────────────────────────────────────────────────
# Used for the Instagram OAuth redirect and as the allowed CORS origin. Update these for production.
BACKEND_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API (CORS): FRONTEND_URL plus this optional comma-separated list.
# A Worker running on localhost also allows the Vite dev server.
# ALLOWED_ORIGINS=https://preview.example.pages.dev
