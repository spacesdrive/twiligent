# ── Supabase (frontend auth) ──────────────────────────────────────────────────
# From: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Backend URL ───────────────────────────────────────────────────────────────
# Local dev: leave blank (defaults to http://localhost:8787)
# Production: set to your Cloudflare Worker URL
VITE_API_URL=https://twiligent.your-subdomain.workers.dev/api

# ── Administrator contact (optional) ─────────────────────────────────────────
# Shown to people who need Instagram tester access or whose scheduled posts
# are not publishing. Defaults to ujjwal@aevrin.net when unset.
VITE_ADMIN_EMAIL=you@example.com
